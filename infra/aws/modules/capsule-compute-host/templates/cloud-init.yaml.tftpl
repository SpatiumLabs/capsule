#cloud-config

write_files:
  - path: /usr/local/bin/capsule-bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      exec > >(tee /var/log/capsule-bootstrap.log) 2>&1

      log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }
      retry() {
        local max="$${1:-3}"; local delay="$${2:-5}"; shift 2; local i=1
        while true; do
          if "$@"; then return 0; fi
          if (( i >= max )); then return 1; fi
          sleep "$delay"; (( i++ )); (( delay *= 2 ))
        done
      }

      AWS_REGION="${aws_region}"
      DOMAIN_NAME="${domain_name}"
      RUNTIME="${runtime}"
      ARCH="${arch}"
      IDLE_TIMEOUT_SECS="${idle_timeout_secs}"
      CAPSULE_ROOT="/opt/capsule"
      CAPSULE_BIN="$CAPSULE_ROOT/bin"
      CAPSULE_IMAGE_DIR="$CAPSULE_ROOT/image/$ARCH"
      ASSET_CACHE_BUCKET="${asset_cache_bucket}"
      ASSET_CACHE_PREFIX="${asset_cache_prefix}"
      COMMIT="${commit}"

      mkdir -p "$CAPSULE_BIN" "$CAPSULE_IMAGE_DIR" /var/lib/capsule/workspaces /etc/capsule

      # --- Download binaries from S3 ---

      if [[ -z "$ASSET_CACHE_BUCKET" ]]; then
        log "asset cache disabled, expecting binaries at $CAPSULE_BIN and image at $CAPSULE_IMAGE_DIR"
      else
        log "downloading host-agent from s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/capsule-host-agent"
        retry 3 5 aws s3 cp "s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/capsule-host-agent" "$CAPSULE_BIN/capsule-host-agent" --region "$AWS_REGION"
        chmod 0755 "$CAPSULE_BIN/capsule-host-agent"

        log "downloading sandboxd from s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/capsule-sandboxd"
        retry 3 5 aws s3 cp "s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/capsule-sandboxd" "$CAPSULE_BIN/capsule-sandboxd" --region "$AWS_REGION"
        chmod 0755 "$CAPSULE_BIN/capsule-sandboxd"

        log "downloading kernel from s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/kernel/vmlinux"
        retry 3 5 aws s3 cp "s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/kernel/vmlinux" "$CAPSULE_IMAGE_DIR/vmlinux" --region "$AWS_REGION"

        log "downloading rootfs from s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/rootfs.ext4"
        retry 3 5 aws s3 cp "s3://$ASSET_CACHE_BUCKET/$ASSET_CACHE_PREFIX/$COMMIT/$ARCH/rootfs.ext4" "$CAPSULE_IMAGE_DIR/rootfs.ext4" --region "$AWS_REGION"
      fi

      # --- Host Agent Service ---

      cat >"/etc/capsule/host-agent.env" <<EOF_ENV
      CAPSULE_RUNTIME=$RUNTIME
      CAPSULE_PUBLIC_HOST=$DOMAIN_NAME
      CAPSULE_IDLE_TIMEOUT_SECS=$IDLE_TIMEOUT_SECS
      CAPSULE_WORKSPACE_ROOT=/var/lib/capsule/workspaces
      CAPSULE_IMAGE_DIR=$CAPSULE_IMAGE_DIR
      CAPSULE_FIRECRACKER_BIN=/usr/local/bin/firecracker
      CAPSULE_SANDBOXD_BIN=$CAPSULE_BIN/capsule-sandboxd
      RUN_ENV=${environment}
      EOF_ENV
      chmod 0600 "/etc/capsule/host-agent.env"

      cat >/etc/systemd/system/capsule-host-agent.service <<'EOF_SERVICE'
      [Unit]
      Description=Capsule Host Agent
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/capsule/host-agent.env
      ExecStartPre=/usr/bin/test -e /dev/kvm
      ExecStartPre=/usr/bin/test -x /usr/local/bin/firecracker
      ExecStartPre=/usr/bin/test -f /opt/capsule/image/${arch}/vmlinux
      ExecStartPre=/usr/bin/test -f /opt/capsule/image/${arch}/rootfs.ext4
      ExecStart=/opt/capsule/bin/capsule-host-agent
      Restart=on-failure
      RestartSec=5
      WorkingDirectory=/opt/capsule

      [Install]
      WantedBy=multi-user.target
      EOF_SERVICE

      systemctl daemon-reload
      systemctl enable capsule-host-agent.service
      retry 3 5 systemctl restart capsule-host-agent.service
      systemctl --no-pager --full status capsule-host-agent.service

      log "==> bootstrap completed successfully"

runcmd:
  - [bash, /usr/local/bin/capsule-bootstrap.sh]
