RUN_ENV=development
CAPSULE_API_TOKEN=dev
CAPSULE_RUNTIME=stub
CAPSULE_IDLE_TIMEOUT_SECS=300
CAPSULE_WORKSPACE_ROOT=/tmp/capsule-workspaces

CAPSULE_GUEST_AGENT_ADDR=127.0.0.1:9999
CAPSULE_ROOTFS_PATH=$HOME/.local/share/capsule/assets/rootfs.ext4

CAPSULE_FIRECRACKER_BIN=firecracker
CAPSULE_FIRECRACKER_SOCKET_DIR=/tmp

CAPSULE_QEMU_MODE=development
CAPSULE_QEMU_BIN=qemu-system-aarch64
CAPSULE_QEMU_KERNEL_PATH=$HOME/.local/share/capsule/assets/kernel/aarch64/vmlinux
CAPSULE_QEMU_KERNEL_CMDLINE="console=ttyAMA0 reboot=k panic=1 root=/dev/vda rw init=/init nomodules"
CAPSULE_QEMU_ACCEL=hvf:tcg
CAPSULE_QEMU_MEM_MIB=512
CAPSULE_QEMU_VCPUS=1
CAPSULE_QEMU_GUEST_AGENT_PORT=9999
CAPSULE_QEMU_BOOT_TIMEOUT_SECS=30
CAPSULE_QEMU_DISK_SNAPSHOT=true
# Production guest transport (ADR-0003): vsock by default in production mode,
# TCP loopback in development. Set to true on Linux dev to exercise vsock.
CAPSULE_QEMU_ENABLE_VSOCK=false
# Optional explicit guest CID (default: derived from the sandbox id).
# CAPSULE_QEMU_VSOCK_CID=3
CAPSULE_QEMU_VSOCK_PORT=52
# Compatibility fallback only: virtio-serial chardev socket instead of vsock.
# Only honored when CAPSULE_QEMU_ENABLE_VSOCK=false.
CAPSULE_QEMU_SERIAL_FALLBACK=false
